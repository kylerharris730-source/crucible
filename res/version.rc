/* ============================================================================
   version.rc -- the identity Windows reads off the executable.

   This exists because of a real report: the launcher was rejected as malware
   on one machine while being fine on another. Nothing in it is malicious, but
   nothing in it was identifiable either -- an unsigned binary with no version
   resource gives SmartScreen a dialog with blank fields where the publisher
   and product should be, and gives Defender's heuristics nothing to weigh
   against behaviour that legitimately looks like a downloader: fetch an exe
   over the network, write it under %LOCALAPPDATA%, replace yourself, run it.

   A version resource is not a fix. Only code signing is a fix. What it does
   is make the warning say what the program claims to be, keep that claim
   identical across releases so reputation can accumulate against a stable
   identity, and remove "no metadata at all" from the list of reasons to be
   suspicious. It costs nothing and there is no argument for omitting it.

   ONLY NUMBERS ARE PASSED IN FROM THE BUILD, and that shape is forced rather
   than chosen: windres cannot take a quoted string on the command line. It
   fails to requote when it hands the define to cpp, so -DFOO="bar" produces a
   syntax error pointing at whichever VALUE line used it -- a line that is
   perfectly correct, several lines from the actual cause. Numbers survive the
   trip intact, so the build passes a version and a target id, and every
   string lives in here where it cannot be mangled.

       VER_TARGET   1 = the game, 2 = the launcher
       VER_MAJOR / VER_MINOR / VER_PATCH   from the newest git tag
   ========================================================================== */
#include <windows.h>

#ifndef VER_MAJOR
#define VER_MAJOR 0
#endif
#ifndef VER_MINOR
#define VER_MINOR 0
#endif
#ifndef VER_PATCH
#define VER_PATCH 0
#endif
#ifndef VER_TARGET
#define VER_TARGET 1
#endif

/* "0.3.2" out of the three numbers, so the human-readable version cannot
   drift from the binary one. */
#define VER_STR2(x) #x
#define VER_STR(x)  VER_STR2(x)
#define VER_STRING  VER_STR(VER_MAJOR) "." VER_STR(VER_MINOR) "." VER_STR(VER_PATCH)

#if VER_TARGET == 2
#define VER_FILEDESC     "Cinderlift Launcher"
#define VER_INTERNALNAME "cinderlift-launcher"
#define VER_ORIGINALNAME "cinderlift-launcher.exe"
#else
#define VER_FILEDESC     "Cinderlift"
#define VER_INTERNALNAME "cinderlift"
#define VER_ORIGINALNAME "cinderlift.exe"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION    VER_MAJOR, VER_MINOR, VER_PATCH, 0
PRODUCTVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0x0L
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        /* 0409 = US English, 04b0 = Unicode. Must match the Translation
           value at the bottom or Windows shows none of this at all. */
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Cinderlift"
            VALUE "FileDescription",  VER_FILEDESC
            VALUE "FileVersion",      VER_STRING
            VALUE "InternalName",     VER_INTERNALNAME
            VALUE "LegalCopyright",   "Copyright (C) 2026 Cinderlift"
            VALUE "OriginalFilename", VER_ORIGINALNAME
            VALUE "ProductName",      "Cinderlift"
            VALUE "ProductVersion",   VER_STRING
            VALUE "Comments",         "A falling-sand sandbox with real heat, pressure, fluids and circuits."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
